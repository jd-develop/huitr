[
  args, 0 > std::list::nth > N

  [
    args, 0 > std::list::nth > fibomoins2
    args, 1 > std::list::nth > fibomoins1
    args, 2 > std::list::nth > n

    > (n, 1 > std::comp::le,
       [fibomoins1],
       [
         fibomoins2, fibomoins1 > std::math::add > nouveau_terme
         fibomoins1, nouveau_terme, (n, 1 > std::math::minus) > fiboacc
       ] > std::tests::if)
  ] > fiboacc

  > (N, 1 > std::comp::le, [1], [1, 1, N > fiboacc] > std::tests::if)
] > fibonacci

[
  args, 0 > std::list::nth > min
  args, 1 > std::list::nth > max
  args, 2 > std::list::nth > func

  > (min, max > std::comp::eq,
     [()],
     [
        min > func
        min, 1 > std::math::add, max, func > for
     ] > std::tests::if)
] > for

0, 20, [
  args, 0 > std::list::nth > i
  i > std::io::print_no_newline
  ": " > std::io::print_no_newline
  i > fibonacci > std::io::print
] > for
